# ── LLM ───────────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=your_openrouter_or_anthropic_api_key_here
ANTHROPIC_MODEL=meta-llama/llama-3.1-70b-instruct

# ── SERP Data ──────────────────────────────────────────────────────────────────
DATAFORSEO_LOGIN=your_dataforseo_login_here
DATAFORSEO_PASSWORD=your_dataforseo_password_here

# ── Google APIs ────────────────────────────────────────────────────────────────
# OAuth2 credentials from Google Cloud Console (Web Application type)
GSC_CLIENT_ID=your_google_client_id_here
GSC_CLIENT_SECRET=your_google_client_secret_here

# ── App ────────────────────────────────────────────────────────────────────────
SECRET_KEY=your_secret_key_here
ENVIRONMENT=development

# ── WordPress (per-project, set in UI) ────────────────────────────────────────
# WP_BASE_URL=https://your-site.com
# WP_USERNAME=your-wp-username
# WP_APP_PASSWORD=xxxx xxxx xxxx xxxx xxxx xxxx